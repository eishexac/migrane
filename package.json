{
  "name": "migrane",
  "version": "0.3.0",
  "description": "A SQL migration runner that knows nothing about your application.",
  "keywords": [
    "sql",
    "migration",
    "migrations",
    "migrate",
    "postgres",
    "postgresql",
    "database",
    "schema",
    "seed"
  ],
  "author": {
    "name": "eishexac",
    "url": "https://existin.space",
    "email": "hexac@existin.space"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ship": {
        "types": "./dist/ship.d.ts",
        "default": "./dist/ship.js"
      },
      "./drivers/pg": {
        "types": "./dist/drivers/pg.d.ts",
        "default": "./dist/drivers/pg.js"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eishexac/migrane.git"
  },
  "homepage": "https://github.com/eishexac/migrane",
  "bugs": "https://github.com/eishexac/migrane/issues",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "migrane": "./bin/migrane.js"
  },
  "exports": {
    ".": {
      "@source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ship": {
      "@source": "./src/ship.ts",
      "types": "./dist/ship.d.ts",
      "default": "./dist/ship.js"
    },
    "./drivers/pg": {
      "@source": "./src/drivers/pg.ts",
      "types": "./dist/drivers/pg.d.ts",
      "default": "./dist/drivers/pg.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "lint": "eslint .",
    "type:check": "tsc --noEmit && tsc -p tsconfig.ship.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack:check": "pnpm pack --out package.tgz && publint package.tgz && attw package.tgz --profile esm-only && rimraf package.tgz",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "pg": "^8.23.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.10.15",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "pg": "^8.23.0",
    "prettier": "^3.8.4",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
